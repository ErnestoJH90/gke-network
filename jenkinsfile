pipeline {
    agent any // Al ser local, se ejecutará directamente en tu máquina
    
    environment {
        SONAR_SERVER = 'SonarQube' 
    }
    
    stages {
        stage('Descargar Código') {
            steps {
                checkout scmGit(branches: [[name: '*/LTErnestoJH']], extensions: [], userRemoteConfigs: [[credentialsId: 'Ernestojh_JenGitHub', url: 'https://github.com/ErnestoJH90/gke-network.git']])
            }
        }
        
        stage('Análisis SonarQube') {
            steps {
                // Busca la herramienta configurada en el paso 3
                def scannerHome = tool 'SonarScanner'
                
                withSonarQubeEnv("${env.SONAR_SERVER}") {
                    // Ejecuta el scanner local usando la ruta automática de Jenkins
                    powershell "${scannerHome}\\bin\\sonar-scanner.bat"
                }
            }
        }
        
        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }
    }
}
